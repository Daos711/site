# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# API Security (optional, for protecting internal APIs)
API_SECRET=your_random_secret

# Elka embed — generated by the deploy workflow from the ELKA_PASSWORD secret.
# Leave empty locally; the page then renders an inert "not built" state.
NEXT_PUBLIC_ELKA_DIGEST=
